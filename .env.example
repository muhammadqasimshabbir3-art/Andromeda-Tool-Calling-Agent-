# Arabic Document Intelligence Agent — Environment Variables
# Copy this file and fill in your values:
#   cp .env.example .env
#
# Never commit .env or API keys.

# ─── Required: Groq LLM ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant
LLM_PROVIDER=groq
# LLM_MODEL=   # optional override used by all providers
LLM_TEMPERATURE=0

# ─── Optional: LangSmith tracing / authenticated LangGraph ────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=arabic-doc-intelligence

# ─── OCR ──────────────────────────────────────────────────────────────────────
# qari (default) | ain | digital
OCR_ENGINE=qari
OCR_MODEL_ID=NAMAA-Space/Qari-OCR-v0.3-VL-2B-Instruct
# OCR_MODEL_PATH=
OCR_MAX_TOKENS=2000
OCR_DEVICE=auto

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=BAAI/bge-m3
# EMBEDDING_MODEL_PATH=
EMBEDDING_DIMENSIONS=1024

# ─── Chunking & retrieval ─────────────────────────────────────────────────────
# page_aware | recursive | layout_aware | semantic
CHUNK_STRATEGY=page_aware
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# chroma | faiss | qdrant
VECTORSTORE_BACKEND=chroma
# Durable Chroma DB on disk (Apache-2.0). Use "memory" for ephemeral tests.
VECTORSTORE_PERSIST_DIR=data/chroma
# Production vector DB (when VECTORSTORE_BACKEND=qdrant):
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# Seeded Arabic knowledge collection used for chat questions without PDF upload
KNOWLEDGE_COLLECTION=wathiqa_knowledge
RETRIEVAL_TOP_K=5
RETRIEVAL_MODE=hybrid
ENABLE_RERANKER=false
# lexical | cross_encoder
RERANKER_BACKEND=lexical
# RERANKER_MODEL_ID=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
MAX_DOCUMENT_BYTES=52428800
INDEX_CACHE_SIZE=8

# ─── Models on disk (optional overrides) ──────────────────────────────────────
# MODELS_DIR=models
# EMBEDDING_MODEL_PATH=models/bge-m3
# OCR_MODEL_PATH=models/NAMAA-Space__Qari-OCR-v0.3-VL-2B-Instruct

# ─── Logging & local service ports ────────────────────────────────────────────
LOG_LEVEL=INFO
LANGGRAPH_PORT=2024
STREAMLIT_PORT=8501
FRONTEND_PORT=5173

# ─── CORS (LangGraph API — comma-separated, no spaces) ────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:2024,http://127.0.0.1:2024,https://smith.langchain.com

# ─── Frontend (Vite loads these from the repo root via envDir) ────────────────
# VITE_LANGGRAPH_API_URL=http://127.0.0.1:2024
VITE_LANGGRAPH_ASSISTANT_ID=agent
VITE_LANGSMITH_API_KEY=
VITE_DEFAULT_USER_INPUT=ما موضوع هذا المستند؟
VITE_DEFAULT_WEB_SEARCH=false
